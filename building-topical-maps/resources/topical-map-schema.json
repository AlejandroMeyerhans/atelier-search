{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topical Map",
  "description": "Hub-and-spoke topical map with gap analysis. Output of Skill 3 in the topical mapping pipeline.",
  "type": "object",
  "required": ["metadata", "clusters", "gap_summary"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["site", "core_topic", "analysis_date", "total_topic_clusters"],
      "properties": {
        "site": { "type": "string" },
        "core_topic": { "type": "string" },
        "analysis_date": { "type": "string", "format": "date" },
        "total_topic_clusters": { "type": "integer" },
        "total_page_clusters": { "type": "integer" },
        "total_gaps": { "type": "integer" },
        "total_opportunity_volume": { "type": "integer" }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster_name", "cluster_id", "hub", "spokes"],
        "properties": {
          "cluster_name": { "type": "string" },
          "cluster_id": { "type": "string" },
          "hub": {
            "type": "object",
            "required": ["page_cluster_id", "h1_keyword", "status"],
            "properties": {
              "page_cluster_id": { "type": "string" },
              "h1_keyword": { "type": "string" },
              "volume": { "type": "integer" },
              "url": { "type": ["string", "null"] },
              "status": { "type": "string", "enum": ["exists", "exists_needs_rebuild", "gap", "exists_wrong_cluster"] },
              "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
              "priority_score": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "spokes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["page_cluster_id", "h1_keyword", "status"],
              "properties": {
                "page_cluster_id": { "type": "string" },
                "h1_keyword": { "type": "string" },
                "volume": { "type": "integer" },
                "url": { "type": ["string", "null"] },
                "status": { "type": "string", "enum": ["exists", "exists_needs_rebuild", "gap", "exists_wrong_cluster"] },
                "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
                "priority_score": { "type": "number", "minimum": 0, "maximum": 1 },
                "total_cluster_volume": { "type": "integer" }
              }
            }
          },
          "total_volume": { "type": "integer" },
          "spoke_count": { "type": "integer" },
          "gap_count": { "type": "integer" }
        }
      }
    },
    "gap_summary": {
      "type": "object",
      "properties": {
        "missing_hubs": { "type": "integer" },
        "missing_spokes": { "type": "integer" },
        "needs_rebuild": { "type": "integer" },
        "orphan_pages": { "type": "integer" },
        "prune_candidates": { "type": "integer" }
      }
    },
    "orphan_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "current_traffic": { "type": "integer" },
          "recommendation": { "type": "string", "enum": ["prune_or_merge", "reassign", "keep"] },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
